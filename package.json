{
  "name": "anti-fwd-spam-worker-tools",
  "private": true,
  "scripts": {
    "build": "uv run pywrangler deploy --dry-run",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "PYTHONPATH=src uv run python -m unittest discover -s tests -v",
    "pretest:e2e": "rm -rf .wrangler/test-build && npm run build -- --outdir .wrangler/test-build",
    "test:e2e": "node --test tests/*.test.mjs",
    "test:contract": "node --test tests/telegram.contract.mjs"
  },
  "devDependencies": {
    "wrangler": "4.132.0"
  }
}
