{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "anti-fwd-spam",
  "main": "src/entry.py",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["python_workers"],
  "vars": {
    "BOT_USERNAME": "niuqu_icn_bot"
  },
  "d1_databases": [
    {
      "binding": "REPORTS",
      "database_name": "anti-fwd-spam-reports",
      "database_id": "ad70e29e-f518-43b0-a3f2-2d067a64ccc5",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  }
}
